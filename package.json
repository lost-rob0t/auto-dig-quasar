  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.1",
    "@types/pouchdb-browser": "^6.1.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
